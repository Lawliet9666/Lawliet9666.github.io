<div class="col mb-4">
  <a class="project-card-link" href="{{ project.url | relative_url }}">
    <article class="project-card h-100">
      <div class="project-card-media">
        {% if project.img %}
          {% include figure.liquid loading="eager" path=project.img sizes="(min-width: 1200px) 240px, 45vw" alt=project.title class="project-card-image" %}
        {% endif %}
      </div>
      <div class="project-card-body">
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
        <span class="project-card-more">View project <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
      </div>
    </article>
  </a>
</div>
