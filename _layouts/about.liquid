---
layout: default
---
<div class="home-sidebar-page">
  {% include home_sidebar.liquid active='about' %}

  <main class="home-main-content home-landing-content">
    <figure class="home-campus-hero">
      <img
        src="{{ '/assets/img/ou-campus-aerial.webp' | relative_url }}"
        width="2000"
        height="750"
        alt="Aerial view of the Oakland University campus, Bear Lake, and Elliott Tower"
        loading="eager"
      >
      <figcaption>
        Photo:
        <a href="https://x.com/oaklandu">Oakland University</a>
      </figcaption>
    </figure>

    <section class="home-lab-showcase" aria-label="SCALE Lab and featured publications">
      <article class="scale-lab-intro">
        <h1>SCALE</h1>
        <p class="scale-lab-subtitle">Safe Control and Learning for Embodied Autonomy</p>
        <p>
          We develop safe and trustworthy autonomous systems—from perception to planning, control, and coordination.
        </p>
        <p>
          <strong>How can robots learn and adapt to an uncertain world while remaining safe?</strong>
        </p>
        <a class="scale-lab-link" href="{{ '/projects/' | relative_url }}">
          <span>Explore our research</span><i class="ti ti-arrow-right" aria-hidden="true"></i>
        </a>
      </article>

      {% include home_publication_carousel.liquid %}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="home-section" aria-labelledby="news-title">
        <header class="home-section-header">
          <h2 id="news-title"><a href="{{ '/news/' | relative_url }}">News</a></h2>
        </header>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </main>
</div>
<script src="{{ '/assets/js/home-carousel.js' | relative_url }}" defer></script>
