---
layout: default
---
<div class="home-sidebar-page">
  {% include home_sidebar.liquid active='about' %}

  <main class="home-main-content home-landing-content">
    <figure class="home-campus-hero">
      <img
        src="{{ '/assets/img/ou-elliott-tower.webp' | relative_url }}"
        width="2000"
        height="625"
        alt="Elliott Tower on the Oakland University campus"
        loading="eager"
      >
      <figcaption>
        Photo:
        <a href="https://www.oakland.edu/elliott-tower/">Oakland University</a>
      </figcaption>
    </figure>

    <section class="home-lab-showcase" aria-label="SCALE Lab and featured publications">
      <article class="scale-lab-intro">
        <h1>Safety-Critical Autonomy, Learning, and Engineering (SCALE) Lab</h1>
        <p>
          At SCALE Lab, we develop safe and trustworthy autonomous systems across multiple layers—from perception and learning to
          decision-making, planning, control, and multi-robot coordination.
        </p>
        <p>
          We combine learning-based methods with control-theoretic guarantees so robots can adapt to uncertainty while maintaining safety.
          Our work connects rigorous theory with practical robotic systems.
        </p>
        <a class="scale-lab-link" href="{{ '/projects/' | relative_url }}">
          <span>Explore our research</span><i class="ti ti-arrow-right" aria-hidden="true"></i>
        </a>
      </article>

      {% include home_publication_carousel.liquid %}
    </section>

    {% if page.announcements and page.announcements.enabled %}
      <section id="news" class="home-section" aria-labelledby="news-title">
        <header class="home-section-header">
          <h2 id="news-title"><a href="{{ '/news/' | relative_url }}">News</a></h2>
        </header>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </main>
</div>
<script src="{{ '/assets/js/home-carousel.js' | relative_url }}" defer></script>
